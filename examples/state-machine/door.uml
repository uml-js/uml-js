<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20131001/DC" xmlns:di="http://www.omg.org/spec/DD/20131001/DI">
  <uml:Model xmi:id="model" name="Door">
    <packagedElement xmi:type="uml:StateMachine" xmi:id="DoorSM" name="DoorSM">
      <region xmi:id="DoorSM_region">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="initial" kind="initial"/>
        <subvertex xmi:type="uml:State" xmi:id="Closed" name="Closed"/>
        <subvertex xmi:type="uml:State" xmi:id="Open" name="Open" submachine="OpenDoor">
          <connection xmi:id="Open_slammed" exit="slammed"/>
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="Open_entry">
            <body>lightOn</body>
          </entry>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="Locked" name="Locked">
          <region xmi:id="Locked_region">
            <subvertex xmi:type="uml:Pseudostate" xmi:id="Locked_initial" kind="initial"/>
            <subvertex xmi:type="uml:State" xmi:id="Armed" name="Armed"/>
            <subvertex xmi:type="uml:State" xmi:id="Alarm" name="Alarm"/>
            <transition xmi:id="t_locked_init" source="Locked_initial" target="Armed"/>
            <transition xmi:id="t_alarm" source="Armed" target="Alarm" guard="t_alarm_guard">
              <ownedRule xmi:type="uml:Constraint" xmi:id="t_alarm_guard">
                <specification xmi:type="uml:OpaqueExpression" xmi:id="t_alarm_guard_spec">
                  <body>$t &gt; t_{\max}$</body>
                </specification>
              </ownedRule>
              <trigger xmi:id="t_alarm_trigger" name="forced"/>
            </transition>
          </region>
        </subvertex>
        <subvertex xmi:type="uml:FinalState" xmi:id="final"/>
        <transition xmi:id="t_init" source="initial" target="Closed"/>
        <transition xmi:id="t_open" source="Closed" target="Open" guard="t_open_guard">
          <ownedRule xmi:type="uml:Constraint" xmi:id="t_open_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t_open_guard_spec">
              <body>!locked</body>
            </specification>
          </ownedRule>
          <trigger xmi:id="t_open_trigger" name="open"/>
        </transition>
        <transition xmi:id="t_close" source="Open" target="Closed">
          <trigger xmi:id="t_close_trigger" name="close"/>
        </transition>
        <transition xmi:id="t_lock" source="Closed" target="Locked">
          <trigger xmi:id="t_lock_trigger" name="lock"/>
          <effect xmi:type="uml:OpaqueBehavior" xmi:id="t_lock_effect">
            <body>engageBolt</body>
          </effect>
        </transition>
        <transition xmi:id="t_unlock" source="Locked" target="Closed">
          <trigger xmi:id="t_unlock_trigger" name="unlock"/>
        </transition>
        <transition xmi:id="t_slammed" source="Open_slammed" target="Closed"/>
        <transition xmi:id="t_remove" source="Closed" target="final">
          <trigger xmi:id="t_remove_trigger" name="remove"/>
        </transition>
      </region>
    </packagedElement>
    <packagedElement xmi:type="uml:StateMachine" xmi:id="OpenDoor" name="OpenDoor">
      <region xmi:id="OpenDoor_region">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="OpenDoor_initial" kind="initial"/>
        <subvertex xmi:type="uml:State" xmi:id="Ajar" name="Ajar"/>
        <subvertex xmi:type="uml:State" xmi:id="WideOpen" name="Wide open"/>
        <transition xmi:id="t_ajar" source="OpenDoor_initial" target="Ajar"/>
        <transition xmi:id="t_push" source="Ajar" target="WideOpen">
          <trigger xmi:id="t_push_trigger" name="push"/>
        </transition>
        <transition xmi:id="t_slam" source="WideOpen" target="slammed">
          <trigger xmi:id="t_slam_trigger" name="gust"/>
        </transition>
      </region>
      <connectionPoint xmi:id="slammed" name="slammed" kind="exitPoint"/>
    </packagedElement>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="DoorSM_diagram" name="DoorSM" modelElement="DoorSM">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="initial_di" modelElement="initial">
      <bounds x="80" y="148" width="24" height="24"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Closed_di" modelElement="Closed">
      <bounds x="200" y="130" width="120" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Open_di" modelElement="Open">
      <bounds x="480" y="120" width="140" height="80"/>
      <ownedElement xmi:type="umldi:UMLShape" xmi:id="Open_slammed_di" modelElement="Open_slammed">
        <bounds x="550" y="190" width="20" height="20"/>
        <ownedElement xmi:type="umldi:UMLLabel" xmi:id="Open_slammed_label" modelElement="Open_slammed">
          <bounds x="574" y="206" width="56" height="20"/>
        </ownedElement>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Locked_di" modelElement="Locked">
      <bounds x="160" y="330" width="450" height="160"/>
      <ownedElement xmi:type="umldi:UMLShape" xmi:id="Locked_initial_di" modelElement="Locked_initial">
        <bounds x="190" y="413" width="24" height="24"/>
      </ownedElement>
      <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Armed_di" modelElement="Armed">
        <bounds x="250" y="395" width="100" height="60"/>
      </ownedElement>
      <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Alarm_di" modelElement="Alarm">
        <bounds x="490" y="395" width="100" height="60"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="final_di" modelElement="final">
      <bounds x="680" y="145" width="30" height="30"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_init_di" modelElement="t_init" source="initial_di" target="Closed_di">
      <waypoint x="104" y="160"/>
      <waypoint x="200" y="160"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_open_di" modelElement="t_open" source="Closed_di" target="Open_di">
      <waypoint x="320" y="145"/>
      <waypoint x="480" y="145"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_open_label" modelElement="t_open">
        <bounds x="345" y="120" width="110" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_close_di" modelElement="t_close" source="Open_di" target="Closed_di">
      <waypoint x="480" y="180"/>
      <waypoint x="320" y="180"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_close_label" modelElement="t_close">
        <bounds x="375" y="185" width="50" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_lock_di" modelElement="t_lock" source="Closed_di" target="Locked_di">
      <waypoint x="235" y="190"/>
      <waypoint x="235" y="330"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_lock_label" modelElement="t_lock">
        <bounds x="125" y="250" width="105" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_unlock_di" modelElement="t_unlock" source="Locked_di" target="Closed_di">
      <waypoint x="285" y="330"/>
      <waypoint x="285" y="190"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_unlock_label" modelElement="t_unlock">
        <bounds x="292" y="250" width="50" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_slammed_di" modelElement="t_slammed" source="Open_slammed_di" target="Closed_di">
      <waypoint x="560" y="210"/>
      <waypoint x="560" y="240"/>
      <waypoint x="305" y="240"/>
      <waypoint x="305" y="190"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_remove_di" modelElement="t_remove" source="Closed_di" target="final_di">
      <waypoint x="300" y="130"/>
      <waypoint x="300" y="80"/>
      <waypoint x="695" y="80"/>
      <waypoint x="695" y="145"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_remove_label" modelElement="t_remove">
        <bounds x="480" y="58" width="60" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_locked_init_di" modelElement="t_locked_init" source="Locked_initial_di" target="Armed_di">
      <waypoint x="214" y="425"/>
      <waypoint x="250" y="425"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_alarm_di" modelElement="t_alarm" source="Armed_di" target="Alarm_di">
      <waypoint x="350" y="425"/>
      <waypoint x="490" y="425"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_alarm_label" modelElement="t_alarm">
        <bounds x="365" y="403" width="110" height="20"/>
      </ownedElement>
    </ownedElement>
  </umldi:UMLStateMachineDiagram>
  <umldi:UMLStateMachineDiagram xmi:id="OpenDoor_diagram" name="OpenDoor" modelElement="OpenDoor">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="OpenDoor_initial_di" modelElement="OpenDoor_initial">
      <bounds x="80" y="78" width="24" height="24"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Ajar_di" modelElement="Ajar">
      <bounds x="160" y="60" width="100" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="WideOpen_di" modelElement="WideOpen">
      <bounds x="400" y="60" width="100" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_ajar_di" modelElement="t_ajar" source="OpenDoor_initial_di" target="Ajar_di">
      <waypoint x="104" y="90"/>
      <waypoint x="160" y="90"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_push_di" modelElement="t_push" source="Ajar_di" target="WideOpen_di">
      <waypoint x="260" y="90"/>
      <waypoint x="400" y="90"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="slammed_di" modelElement="slammed">
      <bounds x="580" y="80" width="20" height="20"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="slammed_label" modelElement="slammed">
        <bounds x="562" y="104" width="56" height="20"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t_slam_di" modelElement="t_slam" source="WideOpen_di" target="slammed_di">
      <waypoint x="500" y="90"/>
      <waypoint x="580" y="90"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t_slam_label" modelElement="t_slam">
        <bounds x="520" y="68" width="40" height="20"/>
      </ownedElement>
    </ownedElement>
  </umldi:UMLStateMachineDiagram>
</xmi:XMI>
