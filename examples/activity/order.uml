      <bounds x="890" y="95" width="30" height="30"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f1_di" modelElement="p_f1" source="p_initial_di" target="p_pick_di">
      <waypoint x="124" y="110"/>
      <waypoint x="170" y="110"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f2_di" modelElement="p_f2" source="p_pick_di" target="p_fragile_di">
      <waypoint x="290" y="110"/>
      <waypoint x="350" y="110"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f3_di" modelElement="p_f3" source="p_fragile_di" target="p_wrap_di">
      <waypoint x="368" y="92"/>
      <waypoint x="368" y="45"/>
      <waypoint x="440" y="45"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f4_di" modelElement="p_f4" source="p_fragile_di" target="p_merge_di">
      <waypoint x="386" y="110"/>
      <waypoint x="620" y="110"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f5_di" modelElement="p_f5" source="p_wrap_di" target="p_merge_di">
      <waypoint x="560" y="45"/>
      <waypoint x="638" y="45"/>
      <waypoint x="638" y="92"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f6_di" modelElement="p_f6" source="p_merge_di" target="p_box_di">
      <waypoint x="656" y="110"/>
      <waypoint x="710" y="110"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="p_f7_di" modelElement="p_f7" source="p_box_di" target="p_final_di">
      <waypoint x="830" y="110"/>
      <waypoint x="890" y="110"/>
    </ownedElement>
  </umldi:UMLActivityDiagram>
</xmi:XMI>
