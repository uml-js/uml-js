<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20131001/DC" xmlns:di="http://www.omg.org/spec/DD/20131001/DI">
  <uml:Model xmi:id="model" name="Orders">
    <packagedElement xmi:type="uml:Activity" xmi:id="ProcessOrder" name="Process order" partition="customer shop warehouse">
      <node xmi:type="uml:InitialNode" xmi:id="initial" outgoing="f_start" inPartition="customer"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="place" name="Place order" incoming="f_start" inPartition="customer">
        <outputValue xmi:id="place_out" name="order" outgoing="f_order" inPartition="customer"/>
      </node>
      <node xmi:type="uml:OpaqueAction" xmi:id="receive" name="Receive order" outgoing="f_check" inPartition="shop">
        <inputValue xmi:id="receive_in" name="order" incoming="f_order" inPartition="shop"/>
        <outputValue xmi:id="receive_out" name="order" outgoing="f_store" inPartition="shop"/>
      </node>
      <node xmi:type="uml:DataStoreNode" xmi:id="orders" name="Orders" incoming="f_store" outgoing="f_items" inPartition="shop"/>
      <node xmi:type="uml:DecisionNode" xmi:id="check" incoming="f_check" outgoing="f_reject f_pay" inPartition="shop"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="reject" name="Reject order" incoming="f_reject" outgoing="f_rejected" inPartition="customer"/>
      <node xmi:type="uml:FlowFinalNode" xmi:id="rejected" incoming="f_rejected" inPartition="customer"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="pay" name="Wait for payment" incoming="f_pay" outgoing="f_paid" inPartition="shop" inInterruptibleRegion="payment"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="cancelled" name="Cancellation requested" outgoing="f_cancel" inPartition="shop" inInterruptibleRegion="payment"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="cancel" name="Cancel order" incoming="f_cancel" outgoing="f_cancelled" inPartition="customer"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="cancel_final" incoming="f_cancelled" inPartition="customer"/>
      <node xmi:type="uml:ForkNode" xmi:id="fork" incoming="f_paid" outgoing="f_invoice f_pack" inPartition="shop"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="invoice" name="Send invoice" incoming="f_invoice" outgoing="f_invoiced" inPartition="shop"/>
      <node xmi:type="uml:ExpansionRegion" xmi:id="pack" name="Pack items" incoming="f_pack" inPartition="warehouse" mode="parallel" inputElement="items" outputElement="parcels">
        <node xmi:type="uml:CallBehaviorAction" xmi:id="pack_item" inPartition="warehouse" behavior="PackItem">
          <argument xmi:id="pack_item_in" name="item" incoming="f_item" inPartition="warehouse"/>
          <result xmi:id="pack_item_out" name="parcel" outgoing="f_parcel" inPartition="warehouse"/>
        </node>
        <edge xmi:type="uml:ObjectFlow" xmi:id="f_item" source="items" target="pack_item_in" inPartition="warehouse"/>
        <edge xmi:type="uml:ObjectFlow" xmi:id="f_parcel" source="pack_item_out" target="parcels" inPartition="warehouse"/>
      </node>
      <node xmi:type="uml:ExpansionNode" xmi:id="items" name="items" incoming="f_items" outgoing="f_item" inPartition="warehouse" regionAsInput="pack"/>
      <node xmi:type="uml:ExpansionNode" xmi:id="parcels" name="parcels" incoming="f_parcel" outgoing="f_ship" inPartition="warehouse" regionAsOutput="pack"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="ship" name="Ship parcels" outgoing="f_shipped" inPartition="warehouse">
        <inputValue xmi:id="ship_in" name="parcels" incoming="f_ship" inPartition="warehouse"/>
      </node>
      <node xmi:type="uml:JoinNode" xmi:id="join" incoming="f_invoiced f_shipped" outgoing="f_end" inPartition="shop"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="final" incoming="f_end" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_start" source="initial" target="place" inPartition="customer"/>
      <edge xmi:type="uml:ObjectFlow" xmi:id="f_order" source="place_out" target="receive_in"/>
      <edge xmi:type="uml:ObjectFlow" xmi:id="f_store" source="receive_out" target="orders" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_check" source="receive" target="check" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_reject" source="check" target="reject">
        <guard xmi:type="uml:OpaqueExpression" xmi:id="f_reject_guard">
          <body>else</body>
        </guard>
      </edge>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_rejected" source="reject" target="rejected" inPartition="customer"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_pay" source="check" target="pay" inPartition="shop">
        <guard xmi:type="uml:OpaqueExpression" xmi:id="f_pay_guard">
          <body>in stock</body>
        </guard>
      </edge>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_cancel" source="cancelled" target="cancel" interrupts="payment"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_cancelled" source="cancel" target="cancel_final" inPartition="customer"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_paid" source="pay" target="fork" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_invoice" source="fork" target="invoice" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_pack" source="fork" target="pack"/>
      <edge xmi:type="uml:ObjectFlow" xmi:id="f_items" source="orders" target="items"/>
      <edge xmi:type="uml:ObjectFlow" xmi:id="f_ship" source="parcels" target="ship_in" inPartition="warehouse"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_invoiced" source="invoice" target="join" inPartition="shop"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_shipped" source="ship" target="join"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="f_end" source="join" target="final" inPartition="shop"/>
      <group xmi:type="uml:ActivityPartition" xmi:id="customer" name="Customer" node="initial place place_out reject rejected cancel cancel_final" edge="f_start f_rejected f_cancelled"/>
      <group xmi:type="uml:ActivityPartition" xmi:id="shop" name="Shop" node="receive receive_in receive_out orders check pay cancelled fork invoice join final" edge="f_store f_check f_pay f_paid f_invoice f_invoiced f_end"/>
      <group xmi:type="uml:ActivityPartition" xmi:id="warehouse" name="Warehouse" node="pack items parcels pack_item pack_item_in pack_item_out ship ship_in" edge="f_item f_parcel f_ship"/>
      <group xmi:type="uml:InterruptibleActivityRegion" xmi:id="payment" name="Payment" node="pay cancelled" interruptingEdge="f_cancel"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Activity" xmi:id="PackItem" name="Pack item">
      <node xmi:type="uml:InitialNode" xmi:id="p_initial" outgoing="p_f1"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="p_pick" name="Pick item" incoming="p_f1" outgoing="p_f2"/>
      <node xmi:type="uml:DecisionNode" xmi:id="p_fragile" incoming="p_f2" outgoing="p_f3 p_f4"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="p_wrap" name="Wrap item" incoming="p_f3" outgoing="p_f5"/>
      <node xmi:type="uml:MergeNode" xmi:id="p_merge" incoming="p_f4 p_f5" outgoing="p_f6"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="p_box" name="Box item" incoming="p_f6" outgoing="p_f7"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="p_final" incoming="p_f7"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f1" source="p_initial" target="p_pick"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f2" source="p_pick" target="p_fragile"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f3" source="p_fragile" target="p_wrap">
        <guard xmi:type="uml:OpaqueExpression" xmi:id="p_f3_guard">
          <body>fragile</body>
        </guard>
      </edge>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f4" source="p_fragile" target="p_merge">
        <guard xmi:type="uml:OpaqueExpression" xmi:id="p_f4_guard">
          <body>else</body>
        </guard>
      </edge>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f5" source="p_wrap" target="p_merge"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f6" source="p_merge" target="p_box"/>
      <edge xmi:type="uml:ControlFlow" xmi:id="p_f7" source="p_box" target="p_final"/>
    </packagedElement>
  </uml:Model>
  <umldi:UMLActivityDiagram xmi:id="ProcessOrder_diagram" name="Process order" modelElement="ProcessOrder">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="customer_di" modelElement="customer">
      <bounds x="40" y="20" width="260" height="1020"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="shop_di" modelElement="shop">
