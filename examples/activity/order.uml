      <waypoint x="422" y="248"/>
      <waypoint x="230" y="248"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="f_rejected_di" modelElement="f_rejected" source="reject_di" target="rejected_di">
      <waypoint x="170" y="273"/>
      <waypoint x="170" y="300"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="f_pay_di" modelElement="f_pay" source="check_di" target="pay_di">
