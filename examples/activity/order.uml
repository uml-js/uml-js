    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="f_invoice_di" modelElement="f_invoice" source="fork_di" target="invoice_di">
      <waypoint x="560" y="508"/>
      <waypoint x="560" y="535"/>
      <waypoint x="440" y="535"/>
      <waypoint x="440" y="560"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="f_pack_di" modelElement="f_pack" source="fork_di" target="pack_di">
