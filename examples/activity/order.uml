      <waypoint x="600" y="970"/>
    </ownedElement>
  </umldi:UMLActivityDiagram>
  <umldi:UMLActivityDiagram xmi:id="PackItem_diagram" name="Pack item" modelElement="PackItem">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="p_initial_di" modelElement="p_initial">
      <bounds x="100" y="98" width="24" height="24"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="p_pick_di" modelElement="p_pick">
