<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20131001/DC" xmlns:di="http://www.omg.org/spec/DD/20131001/DI">
  <uml:Model xmi:id="model" name="Preview">
    <packagedElement xmi:type="uml:StateMachine" xmi:id="sm" name="Machine">
      <region xmi:id="region">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="initial" kind="initial"/>
        <subvertex xmi:type="uml:State" xmi:id="Idle" name="Idle">
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="Idle_entry">
            <body>reset</body>
          </entry>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="Running" name="Running">
          <region xmi:id="Running_region">
            <subvertex xmi:type="uml:Pseudostate" xmi:id="Running_initial" kind="initial"/>
            <subvertex xmi:type="uml:State" xmi:id="Slow" name="Slow"/>
            <subvertex xmi:type="uml:State" xmi:id="Fast" name="Fast"/>
            <transition xmi:id="r1" source="Running_initial" target="Slow"/>
            <transition xmi:id="r2" source="Slow" target="Fast">
              <trigger xmi:id="r2_trigger" name="up"/>
            </transition>
            <transition xmi:id="r3" source="Fast" target="Slow">
              <trigger xmi:id="r3_trigger" name="down"/>
            </transition>
          </region>
        </subvertex>
        <subvertex xmi:type="uml:FinalState" xmi:id="final"/>
        <transition xmi:id="t1" source="initial" target="Idle"/>
        <transition xmi:id="t2" source="Idle" target="Running">
          <trigger xmi:id="t2_trigger" name="start"/>
        </transition>
        <transition xmi:id="t4" source="Running" target="Idle">
          <trigger xmi:id="t4_trigger" name="pause"/>
        </transition>
        <transition xmi:id="t3" source="Running" target="final">
          <trigger xmi:id="t3_trigger" name="stop"/>
        </transition>
      </region>
    </packagedElement>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="diagram" name="Machine" modelElement="sm">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="initial_di" modelElement="initial">
      <bounds x="20" y="68" width="24" height="24"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Idle_di" modelElement="Idle">
      <bounds x="80" y="50" width="100" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Running_di" modelElement="Running">
      <bounds x="250" y="20" width="230" height="120"/>
      <ownedElement xmi:type="umldi:UMLShape" xmi:id="Running_initial_di" modelElement="Running_initial">
        <bounds x="262" y="81" width="18" height="18"/>
      </ownedElement>
      <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Slow_di" modelElement="Slow">
        <bounds x="305" y="70" width="60" height="40"/>
      </ownedElement>
      <ownedElement xmi:type="umldi:UMLStateShape" xmi:id="Fast_di" modelElement="Fast">
        <bounds x="405" y="70" width="60" height="40"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="final_di" modelElement="final">
      <bounds x="530" y="65" width="30" height="30"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t1_di" modelElement="t1" source="initial_di" target="Idle_di">
      <waypoint x="44" y="80"/>
      <waypoint x="80" y="80"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t2_di" modelElement="t2" source="Idle_di" target="Running_di">
      <waypoint x="180" y="70"/>
      <waypoint x="250" y="70"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t2_label" modelElement="t2">
        <bounds x="200" y="52" width="30" height="15"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t4_di" modelElement="t4" source="Running_di" target="Idle_di">
      <waypoint x="250" y="100"/>
      <waypoint x="180" y="100"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t4_label" modelElement="t4">
        <bounds x="197" y="104" width="34" height="15"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="t3_di" modelElement="t3" source="Running_di" target="final_di">
      <waypoint x="480" y="80"/>
      <waypoint x="530" y="80"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="t3_label" modelElement="t3">
        <bounds x="490" y="62" width="30" height="15"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="r1_di" modelElement="r1" source="Running_initial_di" target="Slow_di">
      <waypoint x="280" y="90"/>
      <waypoint x="305" y="90"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="r2_di" modelElement="r2" source="Slow_di" target="Fast_di">
      <waypoint x="365" y="80"/>
      <waypoint x="405" y="80"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="r2_label" modelElement="r2">
        <bounds x="375" y="62" width="20" height="15"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="r3_di" modelElement="r3" source="Fast_di" target="Slow_di">
      <waypoint x="405" y="100"/>
      <waypoint x="365" y="100"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="r3_label" modelElement="r3">
        <bounds x="370" y="104" width="30" height="15"/>
      </ownedElement>
    </ownedElement>
  </umldi:UMLStateMachineDiagram>
</xmi:XMI>
